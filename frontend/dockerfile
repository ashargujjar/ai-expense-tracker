# Stage 1: Build the React + Vite application
FROM node:20-alpine AS build

WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Install packages
RUN npm install --legacy-peer-deps

# Copy application source files
COPY . .

# Compile TypeScript and bundle app
RUN npm run build

# Stage 2: Production server container using Nginx
FROM nginx:1.25-alpine

# Copy built bundle assets from Stage 1
COPY --from=build /app/dist /usr/share/nginx/html

# Replace default nginx configuration to handle React Router client-side routes redirection
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
    error_page 500 502 503 504 /50x.html; \
    location = /50x.html { \
        root /usr/share/nginx/html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
